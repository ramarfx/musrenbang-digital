# Salin berkas ini menjadi .env, lalu isi dari Dashboard Supabase > Project Settings > API.
# SUPABASE_URL dan SUPABASE_ANON_KEY dipakai aplikasi web (aman untuk publik).
# SUPABASE_SERVICE_ROLE_KEY HANYA untuk skrip seed (bun run seed).
# Kunci service role melewati RLS, jadi tidak boleh masuk ke kode frontend.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_ANON_KEY=xxx
SUPABASE_SERVICE_ROLE_KEY=xxx
