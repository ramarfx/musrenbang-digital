# Root .env — dipakai HANYA oleh skrip seed (`bun run seed`).
# Frontend punya berkas env sendiri: web/.env (hanya kunci publik VITE_*).
# Jangan pernah memakai service role key di web/.env atau kode frontend.
SUPABASE_URL=https://xxx.supabase.co
SUPABASE_SERVICE_ROLE_KEY=xxx

# Nilai aplikasi yang ikut dimuat ke tabel `config`.
KOTA=DKI Jakarta
TAHUN_ANGGARAN=2026
VIRTUAL_BUDGET_PER_WARGA=10000000
